SESSION_SECRET=change-me-to-random-32-byte-secret
ADMIN_PASSWORD=admin123
COOKIE_HTTPS_ONLY=false

# Cấu hình MS SQL Server cho StationeryStoreDB
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_SERVER=localhost
MSSQL_DATABASE=StationeryStoreDB
MSSQL_TRUSTED_CONNECTION=yes
MSSQL_TRUST_SERVER_CERT=yes
# Nếu dùng SQL Auth, đổi MSSQL_TRUSTED_CONNECTION=no và điền:
# MSSQL_USER=sa
# MSSQL_PASSWORD=YourStrongPassword
